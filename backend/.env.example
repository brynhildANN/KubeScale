KUBESCALE_LISTEN=127.0.0.1:8080
KUBESCALE_NAMESPACES=autoscale-demo
KUBESCALE_SQLITE_PATH=./kubescale.db
KUBESCALE_PROMETHEUS_URL=http://127.0.0.1:9090
KUBESCALE_CONTROLLER_INTERVAL=15s
KUBESCALE_METRIC_MAX_AGE=90s
KUBESCALE_QUERY_TIMEOUT=8s
KUBESCALE_CLUSTER_NAME=local-minikube

# Webhook disabled when empty. Never commit the real token.
KUBESCALE_WEBHOOK_TOKEN=
# Explicit opt-in for restricted internal cluster deployment only.
KUBESCALE_ALLOW_REMOTE=false
